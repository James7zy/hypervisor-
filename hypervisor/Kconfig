# Documentation only (Kconfig is not parsed). The arch is chosen by the ARCH
# variable; make <board>_defconfig writes CONFIG_ARCH_*/CONFIG_BOARD_* and the
# Makefile checks they agree with ARCH.
choice
    prompt "Target architecture"
    default ARCH_ARM64
config ARCH_ARM64
    bool "ARM64 (AArch64)"
config ARCH_X86
    bool "x86-64 (link-check stub only, not runnable)"
endchoice

source "hypervisor/arch/arm64/Kconfig"
source "hypervisor/arch/x86/Kconfig"

config DEBUG_UART
    bool "Early UART output"
    default y
