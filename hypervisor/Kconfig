# Selects hypervisor/arch/<arch>/; the top-level Makefile reads CONFIG_ARCH_* and
# CONFIG_BOARD_* from .config to pick the arch directory and board.
choice
    prompt "Target architecture"
    default ARCH_ARM64
config ARCH_ARM64
    bool "ARM64 (AArch64)"
config ARCH_X86
    bool "x86-64 (link-check stub only, not runnable)"
endchoice

source "hypervisor/arch/arm64/Kconfig"
source "hypervisor/arch/x86/Kconfig"

config DEBUG_UART
    bool "Early UART output"
    default y
